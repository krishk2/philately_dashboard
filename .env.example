# Copy to .env and fill in. Never commit .env.

# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to a local SQLite file in instance/.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/philately

# Optional. Enables the AI vision verification check. Get a key from Google AI Studio.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Used by docker-compose for the bundled Postgres.
# POSTGRES_PASSWORD=change-me

# Optional: "Continue with Google / Yahoo" on the philatelist login and registration forms.
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web).
# Yahoo:  developer.yahoo.com/apps > Create an App (OpenID Connect, email + profile).
# Redirect URIs to register:  <your site>/login/google/callback  and  <your site>/login/yahoo/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Optional: extra RSS/Atom feeds for the home page tabs, as kind|label|url (comma-separated),
# kind being release, news or event. India Post and Rainbow Stamp News are built in.
# FEED_EXTRA_RSS=event|My Philatelic Society|https://example.org/events.rss

# ---------- production / deployment ----------
# Behind a load balancer or proxy (Render, AWS ALB). On by default in production.
# TRUST_PROXY=1
# Background jobs: 1 = run in the web process (no worker needed); 0 = run `flask worker`.
# JOBS_INLINE=1
# FEED_REFRESH_HOURS=6
# Minutes an unpaid pre-booking holds its copies.
# PREBOOK_HOLD_MINUTES=30
# Rate limits: share counters between processes/containers with Redis.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# RATELIMIT_ENABLED=1

# Uploads: local disk (default) or any S3-compatible bucket.
# STORAGE_BACKEND=s3
# S3_BUCKET=my-philately-uploads
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=          # Cloudflare R2 / Backblaze B2 / MinIO endpoint; empty for AWS S3
# S3_ACCESS_KEY_ID=         # leave empty on AWS to use the ECS task role
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=            # CDN / public bucket URL; empty = short-lived signed URLs

# India Post requires Department of Posts permission for any use of stamp images.
# Only enable after you have it.
# Shown by default (with credit). Set to 0 to hide India Post's stamp images.
# FEED_SHOW_SOURCE_IMAGES=1
# Contact shown in the disclaimer for takedown requests.
# CONTACT_EMAIL=
