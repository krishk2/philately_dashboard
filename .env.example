# Copy to .env and fill in. Never commit .env.

# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to a local SQLite file in instance/.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/philately

# Optional. Enables the AI vision verification check. Get a key from Google AI Studio.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Used by docker-compose for the bundled Postgres.
# POSTGRES_PASSWORD=change-me

# Optional: "Continue with Google / Yahoo" on the philatelist login and registration forms.
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web).
# Yahoo:  developer.yahoo.com/apps > Create an App (OpenID Connect, email + profile).
# Redirect URIs to register:  <your site>/login/google/callback  and  <your site>/login/yahoo/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Optional: extra RSS/Atom feeds for the home page tabs, as kind|label|url (comma-separated),
# kind being release, news or event. India Post and Rainbow Stamp News are built in.
# FEED_EXTRA_RSS=event|My Philatelic Society|https://example.org/events.rss
