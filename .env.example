# Copy to .env and fill in. Never commit .env.

# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to a local SQLite file in instance/.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/philately

# Optional. Enables the AI vision verification check. Get a key from Google AI Studio.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Used by docker-compose for the bundled Postgres.
# POSTGRES_PASSWORD=change-me
